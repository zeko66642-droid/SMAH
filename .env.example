# انسخ هذا الملف إلى .env (أو ضع القيم في إعدادات الاستضافة). لا ترفع .env إلى GitHub.

# بروكسي اختياري (مهم ليوتيوب من الخوادم). أمثلة:
# PROXY_URL=socks5h://user:pass@host:1080
# PROXY_URL=http://user:pass@host:8080

# كوكيز اختيارية: إما مسار ملف أو محتواه base64
# COOKIES_FILE=/path/to/cookies.txt
# COOKIES_BASE64=

# حدود الأمان
# MAX_CONCURRENT_DOWNLOADS=2
# MAX_FILESIZE=500M
# DOWNLOAD_TIMEOUT_MIN=15
# DISABLE_GENERIC=0

# عدد البروكسيات أمام الخادم (1 على Render/Railway، 0 للتشغيل المباشر)
# TRUST_PROXY=1

# ويندوز فقط إن لم تكن الأدوات في PATH
# FFMPEG_PATH=
# PYTHON_PATH=
